{
  "manifest_version": 3,
  "name": "Cân HR-250A (Hùng Duy)",
  "version": "1.2.0",
  "description": "Nhận số cân từ cân A&D HR-250A qua hộp HungDuyScaleHR250A và gửi vào qlcl.hungduy.vn.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "http://qlcl.hungduy.vn/*",
    "https://qlcl.hungduy.vn/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/main.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Cân HR-250A"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
